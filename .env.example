# Network interception mode:
# - 'true'   : Full MSW v2 mock mode (all 28 endpoints persisted in localStorage)
# - 'hybrid' : Real Express backend for implemented routes (/auth/*, /admin/users/*) + MSW fallback for remaining routes
# - 'false'  : Direct HTTP requests to the backend server with MSW disabled
VITE_USE_MOCK=true

# Base API URL:
# - '/api/v1'                      for full MSW mock mode
# - 'http://localhost:3000/api/v1' for hybrid or full backend mode
VITE_API_BASE_URL=/api/v1
